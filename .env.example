# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env a GitHub

# Tu API Key de Resend (resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email del equipo que recibe las notificaciones de nuevos registros
EMAIL_EQUIPO=hola@librenta.es

# Email remitente (usa noreply@librenta.es cuando el dominio esté verificado en Resend)
# Mientras tanto, usa onboarding@resend.dev para pruebas
RESEND_FROM=noreply@librenta.es

# Puerto (opcional, por defecto 3000)
# PORT=3000
